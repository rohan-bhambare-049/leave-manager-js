# Copy this file to .env and fill in your own values

# Server
PORT=4000

# Local PostgreSQL connection (used while developing on your own laptop)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leave_manager

# Local Postgres does not use SSL, so keep this false on your laptop.
# For Vercel set it to true.
DATABASE_SSL=false

# Neon connection string for deployment(Vercel):
# DATABASE_URL=postgresql://<user>:<password>@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT settings
JWT_SECRET=change_this_to_any_long_random_string
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
